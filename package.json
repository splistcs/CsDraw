{
  "name": "csdraw-desktop",
  "version": "1.0.1",
  "private": true,
  "description": "CsDraw - tactical board, playbooks, media library and 2D demo viewer for Counter-Strike 2",
  "author": "splistcs",
  "main": "electron/main.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,yellow \"vite\" \"wait-on http://localhost:5173 && cross-env CSDRAW_DEV=1 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "test": "node --test \"test/*.test.mjs\"",
    "dist": "vite build && electron-builder",
    "inspect-demo": "node scripts/inspect-demo.mjs",
    "smoke": "electron --no-sandbox scripts/electron-smoke.mjs",
    "release": "vite build && electron-builder --publish always"
  },
  "dependencies": {
    "@laihoe/demoparser2": "^0.42.3",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^45.2.3",
    "electron-builder": "^26.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "vite": "^5.4.10",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.csdraw.app",
    "productName": "CSDraw",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "dist/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "splistcs",
        "repo": "CsDraw"
      }
    ]
  }
}
